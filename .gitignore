# Credenciales y datos locales
.env
.env.*
!.env.example

# Volúmenes y datos de MongoDB
backend/data/
mongo_data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Entornos de editor
.vscode/
.idea/
.DS_Store

# Node (por si se añade un frontend con build)
node_modules/

# Datos de la competición M5: no se versionan (condiciones de Kaggle).
backend/data/m5/*.csv
backend/exportacion/

# Respaldos, entregas y paquetes locales
_respaldo_*/
_revision/
entregas/
paquete-demo/
.openai
accesos.txt

# Despliegue: se versiona la definición del paquete (sitio + API + proxy). Las
# tareas, entornos y entradas propias de cada equipo no se publican.
deploy/*
!deploy/docker-compose.yml
!deploy/docker-compose.m5.yml
!deploy/compose-con-m5.sh
!deploy/M5.md
!deploy/Dockerfile.sitio
!deploy/nginx.conf
!deploy/LEEME.md
!deploy/.env.example

# Evidencias, registros y capturas de verificación locales
evidencias/
*.log
tmp/
