{
  "name": "portafolio-verificacion",
  "private": true,
  "version": "1.0.0",
  "description": "Verificación de las 20 fichas del portafolio con Playwright.",
  "type": "module",
  "scripts": {
    "verificar": "node tools/ejecutar-verificacion.mjs",
    "serve": "python -m http.server 8000 --directory dist",
    "verificar:externo": "node tools/verificar-fichas.mjs",
    "verificar:config": "node tools/verificar-config-produccion.mjs",
    "verificar:limites": "node tools/verificar-limites-ia.mjs",
    "verificar:produccion": "node tools/verificar-produccion.mjs",
    "verificar:real": "node tools/ejecutar-verificacion.mjs --api-real"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
